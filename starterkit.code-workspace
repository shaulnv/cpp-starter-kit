{
	"folders": [
		{
			"name": "starterkit",
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/out": true,
			"**/__pycache__": true,
			"**/.cache": true,
			"**/*.o": true,
			"**/*.lo": true,
			"**/*.a": true,
			"**/*.la": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/bower_components": true,
			"**/*.code-search": true,
			"**/out": true,
			"build/**": true
		},
		"[python]": {
			"editor.defaultFormatter": "ms-python.autopep8"
		},
		"cmakeFormat.exePath": "${workspaceFolder}/.venv/bin/cmake-format",
		"C_Cpp.clang_format_path": "${workspaceFolder}/.venv/bin/clang-format",
		"cmake.cmakePath": "${workspaceFolder}/.venv/bin/cmake",
		"cmake.clearOutputBeforeBuild": true,
		"cmake.automaticReconfigure": true,
		"cmake.sourceDirectory": "${workspaceFolder}",
		"cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
		"cmake.generator": "Ninja",
		"terminal.integrated.profiles.linux": {
			"bash-with-project": {
				"path": "bash",
				"icon": "rocket",
				"args": [
					"--rcfile",
					"${workspaceFolder:starterkit}/.vscode/.vscode-bash-source.sh"
				]
			}
		},
		"terminal.integrated.defaultProfile.linux": "bash-with-project",
		"terminal.integrated.profiles.osx": {
			"zsh-with-project": {
				"path": "/usr/bin/env",
				"icon": "rocket",
				"args": [
					"ZDOTDIR=${workspaceFolder}/.vscode",
					"zsh"
				]
			}
		},
		"terminal.integrated.defaultProfile.osx": "zsh-with-project",
		"C_Cpp.codeAnalysis.exclude": {
			"${workspaceFolder}/build/**": true
		},
		"testMate.cpp.test.advancedExecutables": [
			{
				"pattern": "build/current/**/*{test,Test,TEST}*"
			}
		],
		"clangd.arguments": [
			"--enable-config"
		],
		"clangd.path": "${workspaceFolder}/.venv/bin/clangd",
		"files.associations": {
			"*.tcc": "cpp",
			"*.ipp": "cpp"
		}
	},
	"extensions": {
		"recommendations": [
			"foxundermoon.shell-format",
			"cheshirekow.cmake-format",
			"ms-vscode.cmake-tools",
			"ms-python.autopep8",
			"ms-python.debugpy",
			"ms-python.python",
			"ms-vscode.cpptools",
			"ms-vscode.cpptools-extension-pack",
			"llvm-vs-code-extensions.vscode-clangd",
			"benjamin-simmonds.pythoncpp-debug",
			"eamodio.gitlens",
			"matepek.vscode-catch2-test-adapter",
			"twxs.cmake",
			"josetr.cmake-language-support-vscode",
			"sirmspencer.vscode-autohide"
		]
	}
}
