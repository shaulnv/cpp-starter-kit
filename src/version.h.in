// from: version.h.in
#pragma once

#define STARTERKIT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define STARTERKIT_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define STARTERKIT_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define STARTERKIT_VERSION "@PROJECT_VERSION@"
#define STARTERKIT_VERSION_SEMANTIC "@STARTERKIT_VERSION_SEMANTIC@"
#define STARTERKIT_OS_PACKAGE_NAME "@STARTERKIT_OS_PACKAGE_NAME@"
#define STARTERKIT_BUILD_TIMESTAMP "@STARTERKIT_BUILD_TIMESTAMP@"
#cmakedefine01 STARTERKIT_IS_PRODUCTION_VERSION

#if STARTERKIT_IS_PRODUCTION_VERSION
#  define STARTERKIT_VERSION_STRING                                                          \
    "Starterkit Version: " STARTERKIT_VERSION ", Production OS Package: " STARTERKIT_OS_PACKAGE_NAME \
    ", Build Timestamp: " STARTERKIT_BUILD_TIMESTAMP
#else
#  define STARTERKIT_VERSION_STRING                                                 \
    "Starterkit Version: " STARTERKIT_VERSION ", OS Package: " STARTERKIT_OS_PACKAGE_NAME \
    ", Build Timestamp: " STARTERKIT_BUILD_TIMESTAMP
#endif
